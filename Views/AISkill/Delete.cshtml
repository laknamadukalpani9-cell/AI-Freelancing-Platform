@model AIFreelancingPlatform.Models.Database.AI_Skill

<h2>Delete AI Skill</h2>

<h4>Are you sure you want to delete this skill?</h4>

<div class="border p-3 mb-3">
    <p><strong>Skill ID:</strong> @Model.Skill_ID</p>
    <p><strong>Skill Name:</strong> @Model.Skill_Name</p>
    <p><strong>Description:</strong> @Model.Description</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Skill_ID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>