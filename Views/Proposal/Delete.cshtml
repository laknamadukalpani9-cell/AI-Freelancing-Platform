@model AIFreelancingPlatform.Models.Database.Proposal

<h2>Delete Proposal</h2>

<h4>Are you sure you want to delete this proposal?</h4>

<div class="border p-3 mb-3">
    <p><strong>Proposal ID:</strong> @Model.Proposal_ID</p>
    <p><strong>Project:</strong> @Model.Project?.Project_Name</p>
    <p><strong>Freelancer:</strong> @Model.Freelancer?.Name</p>
    <p><strong>Proposed Amount:</strong> @Model.Proposed_Amount</p>
    <p><strong>Status:</strong> @Model.Proposal_Status</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Proposal_ID" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>