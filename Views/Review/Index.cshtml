@model IEnumerable<AIFreelancingPlatform.Models.Database.Review>

@{
    ViewData["Title"] = "Reviews";
}

<h2 class="mb-4">Review Management</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Review</a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Review ID</th>
            <th>Assignment ID</th>
            <th>Rating</th>
            <th>Comment</th>
            <th>Review Date</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Review_ID</td>
                <td>@item.Assignment_ID</td>
                <td>@item.Rating</td>
                <td>@item.Comment</td>
                <td>@item.Review_Date</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Review_ID"
                       class="btn btn-warning btn-sm">Edit</a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Review_ID"
                       class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>