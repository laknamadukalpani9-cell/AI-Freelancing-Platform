@model AIFreelancingPlatform.Models.Database.Review

<h2>Delete Review</h2>
<h4>Are you sure you want to delete this review?</h4>

<div class="border p-3 mb-3">
    <p><strong>Review ID:</strong> @Model.Review_ID</p>
    <p><strong>Assignment ID:</strong> @Model.Assignment_ID</p>
    <p><strong>Rating:</strong> @Model.Rating</p>
    <p><strong>Comment:</strong> @Model.Comment</p>
    <p><strong>Review Date:</strong> @Model.Review_Date</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Review_ID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>