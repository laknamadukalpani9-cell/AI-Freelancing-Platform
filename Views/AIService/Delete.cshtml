@model AIFreelancingPlatform.Models.Database.AI_Service

@{
    ViewData["Title"] = "Delete AI Service";
}

<h2>Delete AI Service</h2>

<h4>Are you sure you want to delete this service?</h4>

<div class="mb-3">
    <p><strong>Service Name:</strong> @Model.Service_Name</p>
    <p><strong>Description:</strong> @Model.Description</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Service_ID" />

    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>