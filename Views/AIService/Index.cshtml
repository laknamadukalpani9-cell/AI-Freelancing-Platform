@model IEnumerable<AIFreelancingPlatform.Models.Database.AI_Service>

@{
    ViewData["Title"] = "AI Service Management";
}

<h2>AI Service Management</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Add New AI Service</a>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Service Name</th>
            <th>Description</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var service in Model)
        {
            <tr>
                <td>@service.Service_ID</td>
                <td>@service.Service_Name</td>
                <td>@service.Description</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@service.Service_ID"
                       class="btn btn-warning">Edit</a>

                    <a asp-action="Delete" asp-route-id="@service.Service_ID"
                       class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>