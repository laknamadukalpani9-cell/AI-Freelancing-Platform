@model AIFreelancingPlatform.Models.Database.Project

@{
    ViewData["Title"] = "Edit Project";
}

<h2>Edit Project</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Project_ID" />

    <div class="mb-3">
        <label asp-for="Client_ID" class="form-label">Client</label>
        <select asp-for="Client_ID" asp-items="ViewBag.Client_ID" class="form-select">
            <option value="">-- Select Client --</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Project_Name" class="form-label">Project Name</label>
        <input asp-for="Project_Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Budget" class="form-label">Budget</label>
        <input asp-for="Budget" type="number" step="0.01" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label">Status</label>
        <input asp-for="Status" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Update Project</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>

</form>