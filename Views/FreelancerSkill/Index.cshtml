@{
    ViewData["Title"] = "Freelancer Skill Management";
}

<h2>Freelancer Skill Management</h2>

<div class="card p-4 mb-4">
    <h4>Add Skill to Freelancer</h4>

    <form asp-action="Add" method="post">

        <div class="mb-3">
            <label>Freelancer</label>
            <select name="Freelancer_ID" asp-items="ViewBag.Freelancer_ID" class="form-control">
                <option value="">-- Select Freelancer --</option>
            </select>
        </div>

        <div class="mb-3">
            <label>AI Skill</label>
            <select name="Skill_ID" asp-items="ViewBag.Skill_ID" class="form-control">
                <option value="">-- Select Skill --</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Add Skill</button>
    </form>
</div>

<h4>Existing Freelancer Skills</h4>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Freelancer ID</th>
            <th>Freelancer Name</th>
            <th>Skill ID</th>
            <th>Skill Name</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var link in ViewBag.Links)
        {
            <tr>
                <td>@link.Freelancer_ID</td>
                <td>@link.FreelancerName</td>
                <td>@link.Skill_ID</td>
                <td>@link.SkillName</td>
                <td>
                    <form asp-action="Remove" method="post">
                        <input type="hidden" name="Freelancer_ID" value="@link.Freelancer_ID" />
                        <input type="hidden" name="Skill_ID" value="@link.Skill_ID" />

                        <button type="submit" class="btn btn-danger btn-sm"
                                onclick="return confirm('Are you sure you want to remove this skill?')">
                            Remove
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>