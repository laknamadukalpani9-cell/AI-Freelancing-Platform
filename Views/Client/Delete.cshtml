@model AIFreelancingPlatform.Models.Database.Client

@{
    ViewData["Title"] = "Delete Client";
}

<h2>Delete Client</h2>

<h4>Are you sure you want to delete this client?</h4>

<div class="card p-3 mb-3">
    <p><strong>Name:</strong> @Model.Name</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Phone:</strong> @Model.Phone</p>
    <p><strong>Company:</strong> @Model.Company_Name</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Client_ID" />

    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>