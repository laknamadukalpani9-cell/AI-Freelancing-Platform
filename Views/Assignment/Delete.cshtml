@model AIFreelancingPlatform.Models.Database.Assignment

@{
    ViewData["Title"] = "Delete Assignment";
}

<h2>Delete Assignment</h2>

<h4>Are you sure you want to delete this assignment?</h4>

<div class="mb-3">
    <p><strong>Project:</strong> @Model.Project?.Project_Name</p>
    <p><strong>Freelancer:</strong> @Model.Freelancer?.Name</p>
    <p><strong>Start Date:</strong> @Model.Start_Date</p>
    <p><strong>End Date:</strong> @Model.End_Date</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Assignment_ID" />

    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>