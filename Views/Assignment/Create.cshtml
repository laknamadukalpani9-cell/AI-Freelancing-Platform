@model AIFreelancingPlatform.Models.Database.Assignment

@{
    ViewData["Title"] = "Add Assignment";
}

<h2>Add New Assignment</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="Project_ID" class="form-label">Project</label>
        <select asp-for="Project_ID" asp-items="ViewBag.Project_ID" class="form-select">
            <option value="">-- Select Project --</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Freelancer_ID" class="form-label">Freelancer</label>
        <select asp-for="Freelancer_ID" asp-items="ViewBag.Freelancer_ID" class="form-select">
            <option value="">-- Select Freelancer --</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Start_Date" class="form-label">Start Date</label>
        <input asp-for="Start_Date" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="End_Date" class="form-label">End Date</label>
        <input asp-for="End_Date" type="date" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save Assignment</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>

</form>