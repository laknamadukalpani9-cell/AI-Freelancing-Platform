@model AIFreelancingPlatform.Models.Database.Freelancer

@{
    ViewData["Title"] = "Delete Freelancer";
}

<h2>Delete Freelancer</h2>

<h4>Are you sure you want to delete this freelancer?</h4>

<div class="card p-3 mb-3">
    <p><strong>Name:</strong> @Model.Name</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Phone:</strong> @Model.Phone</p>
    <p><strong>Location:</strong> @Model.Location</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Freelancer_ID" />

    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>