@model AIFreelancingPlatform.Models.Database.Payment

<h2>Edit Payment</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Payment_ID" />

    <div class="form-group mb-3">
        <label>Assignment ID</label>
        <select asp-for="Assignment_ID" asp-items="ViewBag.Assignment_ID" class="form-control">
            <option value="">-- Select Assignment --</option>
        </select>
        <span asp-validation-for="Assignment_ID" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Amount">Amount</label>
        <input asp-for="Amount" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Payment_Date">Payment Date</label>
        <input asp-for="Payment_Date" type="date" class="form-control" />
        <span asp-validation-for="Payment_Date" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Payment_Status">Payment Status</label>
        <input asp-for="Payment_Status" class="form-control" />
        <span asp-validation-for="Payment_Status" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>

</form>