@model AIFreelancingPlatform.Models.Database.Payment

<h2>Delete Payment</h2>

<h4>Are you sure you want to delete this payment?</h4>

<div class="border p-3 mb-3">
    <p><strong>Payment ID:</strong> @Model.Payment_ID</p>
    <p><strong>Assignment ID:</strong> @Model.Assignment_ID</p>
    <p><strong>Amount:</strong> @Model.Amount</p>
    <p><strong>Payment Date:</strong> @Model.Payment_Date</p>
    <p><strong>Payment Status:</strong> @Model.Payment_Status</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Payment_ID" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>